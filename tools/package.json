{
  "name": "essence-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preprepare": "node -e \"const fs=require('node:fs');for(const n of fs.readdirSync('../.githooks')){const p='../.githooks/'+n;fs.writeFileSync(p,fs.readFileSync(p,'utf8').replaceAll('\\r\\n','\\n'));}\"",
    "prepare": "git config core.hooksPath .githooks",
    "docs": "node check-docs.ts",
    "secretlint": "node secretlint.mjs",
    "local-paths": "node check-local-paths.ts",
    "skills": "node check-skill-mirror.ts",
    "plugin-imports": "node check-plugin-imports.ts",
    "progress-board": "node progress-board.ts",
    "roadmap-board": "node roadmap-board.ts",
    "section": "node section.ts",
    "check": "npm run docs && npm run secretlint && npm run local-paths && npm run skills && npm run plugin-imports && npm run roadmap-board -- --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "knip": "node run-knip.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=600000 \"tests/**/*.test.ts\"",
    "self-check": "npm run typecheck && npm run lint && npm run knip && npm test"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "github-slugger": "^2.0.0",
    "knip": "^6.42.1",
    "markdown-it": "^14.3.3",
    "secretlint": "^13.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
