{
  // 共用工具自己的 knip 設定（D-208 第二步 §A2）。check-docs.ts 等由 package.json 的 script 自動列為入口。
  // hooks.ts 由 .githooks 直接用 node 執行、沒有程式 import 它，另外列；測試另外列（沒列時測試用到的匯出會被報成沒用到）。
  "entry": ["*.mjs", "hooks.ts", "tests/**/*.test.ts"],
  "project": ["*.{ts,mjs}", "tests/**/*.ts"],
  // secretlint 的 recommend preset 由 .secretlintrc.json 動態載入（secretlint 本身由 secretlint.mjs import）。
  // @emnapi/core、@emnapi/runtime 是 Linux 上 knip 的 wasm 解析器需要的 peer（同 Cards 的 knip.jsonc）。
  "ignoreDependencies": ["@secretlint/secretlint-rule-preset-recommend", "@emnapi/core", "@emnapi/runtime"]
}
