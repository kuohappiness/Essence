{
  // tools/ 有自己的 package.json（共用檢查的相依，D-208 第一步 §1），設成另一個工作區；沒設時 knip 會把那幾個相依報成 Unlisted dependencies。
  // tools/ 裡 Cards 的工具（build.mjs、install、compare 等）照樣用根目錄的相依，第二步搬進 plugins/cards/ 時再分開。
  "workspaces": {
    ".": {
      "entry": ["src/main.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts"],
      // React、react-dom、Motion 由 W6 的畫面（src/ui/）使用。
      // @emnapi/core、@emnapi/runtime 是 Linux 上 knip 的 wasm 解析器需要的 peer；Windows 的 npm install 會把它們從 lock 刪掉，讓 CI 的 npm ci 失敗，所以明列為開發相依。
      // electron 由 Obsidian 電腦版在執行時提供（D-148，只有 src/desktop/ 用），不裝進 node_modules。
      "ignoreDependencies": ["@emnapi/core", "@emnapi/runtime", "electron"]
    },
    "tools": {
      // check-skill-mirror.ts 等由 tools/package.json 的 script 自動列為入口。hooks.ts 由 .githooks 直接用 node 執行、
      // 沒有程式 import 它（D-208 第一步 §3），另外列；沒列時 knip 報它是沒用到的檔。
      "entry": ["*.mjs", "hooks.ts"],
      "project": ["*.{ts,mjs}", "compare/*.ts"],
      // secretlint 的 recommend preset 由 .secretlintrc.json 動態載入（secretlint 本身由 tools/secretlint.mjs import）。
      "ignoreDependencies": ["@secretlint/secretlint-rule-preset-recommend"]
    }
  }
}
