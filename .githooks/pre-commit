#!/bin/sh
set -eu

# core.hooksPath 被改成另一個 checkout 的絕對路徑時（開 worktree 的工具會這樣改），轉給這個 worktree 自己的 hook，
# 新舊分支的 hook 才不會混用（tasks/one-repo-step-1.md〈平台事實〉）。
own="$(git rev-parse --show-toplevel)/.githooks/pre-commit"
if [ -f "$own" ] && ! cmp -s "$0" "$own"; then exec sh "$own" "$@"; fi

# 邏輯在 tools/hooks.ts（D-208 第一步 §3）：照分派表（tools/dispatch.ts）決定跑哪些外掛的檢查，共用檢查每次都跑。
if [ ! -d tools/node_modules ]; then
  echo '先在 tools/ 執行 npm ci（共用檢查的相依）' >&2
  exit 1
fi
exec node tools/hooks.ts pre-commit
