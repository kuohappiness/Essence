#!/bin/sh
set -eu

# core.hooksPath 被改成另一個 checkout 的絕對路徑時（開 worktree 的工具會這樣改），轉給這個 worktree 自己的 hook。
own="$(git rev-parse --show-toplevel)/.githooks/pre-merge-commit"
if [ -f "$own" ] && ! cmp -s "$0" "$own"; then exec sh "$own" "$@"; fi

# 邏輯在 tools/hooks.ts（D-208 第一步 §3）：合併不經過 pre-commit，這裡讀合併的索引跑一次共用檢查；
# 合併進 main 時照分派表的 CI 跑法比合併基點到要合併的 commit，有外掛要跑就要那個 commit 的 push run 是綠燈。
# 快轉與有衝突的合併不經過這個 hook，所以 docs/agents/quality.md 的合併步驟也寫了。gh 不能用或沒登入時警告放行。
if [ ! -d tools/node_modules ]; then
  echo '先在 tools/ 執行 npm ci（共用檢查的相依）' >&2
  exit 1
fi
exec node tools/hooks.ts pre-merge-commit
